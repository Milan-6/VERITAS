# ==============================================================================
# VERITAS: Research Intelligence Platform
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# DO NOT commit the .env file containing production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Identity & Branding
# ------------------------------------------------------------------------------
PROJECT_NAME="VERITAS"
TAGLINE="Research Intelligence. Grounded in Truth."

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for JWT access token encoding/decoding and HMAC verification.
# Generate in production using: openssl rand -hex 32
SECRET_KEY="generate-a-strong-random-secret-key-for-production-use"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fernet symmetric encryption key for integration credentials at rest (Phase 12)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VERITAS_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER="veritas_user"
POSTGRES_PASSWORD="veritas_password"
POSTGRES_DB="veritas_db"
POSTGRES_PORT=5432

# SQLAlchemy connection string
# For Docker Compose:
DATABASE_URL="postgresql://veritas_user:veritas_password@postgres:5432/veritas_db"
# For Local Development with SQLite:
# DATABASE_URL="sqlite:///./veritas.db"

# ------------------------------------------------------------------------------
# 4. Redis Cache, Rate Limiting & Message Broker
# ------------------------------------------------------------------------------
REDIS_PORT=6379
# For Docker Compose:
REDIS_URL="redis://redis:6379/0"
# For Local Development:
# REDIS_URL="redis://localhost:6379/0"

# Celery Task Queue Settings
CELERY_TASK_ALWAYS_EAGER=false
CELERY_LOG_LEVEL="info"
CELERY_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 5. Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_PORT=6333
# For Docker Compose:
QDRANT_URL="http://qdrant:6333"
QDRANT_HOST="qdrant"
# For Local Development:
# QDRANT_URL="http://localhost:6333"
# QDRANT_HOST="localhost"
QDRANT_API_KEY=""
QDRANT_COLLECTION="veritas_research_chunks"
QDRANT_TIMEOUT=5.0
QDRANT_IN_MEMORY=false
QDRANT_LOCAL_PATH="./data/qdrant"

# ------------------------------------------------------------------------------
# 6. LLM & Embedding Services (Google Gemini)
# ------------------------------------------------------------------------------
# API Key for Google Gemini (text-embedding-004 and Gemini 2.0 Flash)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Embedding model configurations
EMBEDDING_MODEL="models/text-embedding-004"
EMBEDDING_DIMENSION=768

# LLM Inference configurations
LLM_MODEL="gemini-2.0-flash"
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 7. Document Storage & Upload Limits
# ------------------------------------------------------------------------------
VERITAS_STORAGE_DIR="uploads/documents"
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB

# ------------------------------------------------------------------------------
# 8. Rate Limiting & Telemetry (Phase 13)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=120
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_HEAVY_REQUESTS=20
RATE_LIMIT_HEAVY_WINDOW=60

# ------------------------------------------------------------------------------
# 9. Academic Discovery Services (Phase 6)
# ------------------------------------------------------------------------------
# Polite pool identification for OpenAlex REST API
OPENALEX_MAILTO="veritas-research@antigravity.ai"

# ------------------------------------------------------------------------------
# 10. Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
